+    // Χειροκίνητη πληκτρολόγηση: δείχνει ποιος του καταλόγου αντιστοιχεί, για να επιλεγεί από εκεί
+    function manualCandidates(text) {
+      const exact = officerOf(text);
+      if (exact) return [exact];
+      const words = norm(text).replace(/[^a-zα-ω0-9 ]/g, " ").split(" ").filter(w => w.length > 2);
+      if (!words.length) return [];
+      return OFFICERS.filter(o => { const k = nameTokens(o.name); return k.length && words.includes(k[0]); }).sort((a, b) => a.rank - b.rank).slice(0, 6);
+    }
+    function pickOfficer(value) {
+      const sel = document.getElementById("officer-select");
+      document.getElementById("officer-filter").value = "";
+      buildOfficerSelect("");
+      sel.value = value;
+      document.getElementById("officer-manual").value = "";
+      showManualMatches();
+      sel.scrollIntoView({ block: "center", behavior: "smooth" });
+    }
+    function showManualMatches() {
+      const box = document.getElementById("manual-matches"), text = document.getElementById("officer-manual").value.trim();
+      const c = text.length >= 3 ? manualCandidates(text) : [];
+      box.innerHTML = "";
+      box.hidden = !c.length;
+      if (!c.length) return;
+      const h = document.createElement("p");
+      h.textContent = c.length === 1 ? "Βρέθηκε στον κατάλογο — πατήστε για να το επιλέξετε:" : "Βρέθηκαν στον κατάλογο — επιλέξτε τον εαυτό σας:";
+      box.appendChild(h);
+      c.forEach(o => {
+        const b = document.createElement("button");
+        b.type = "button"; b.className = "match-btn";
+        b.textContent = `${o.rank}. ${officerValue(o)}`;
+        b.onclick = () => pickOfficer(officerValue(o));
+        box.appendChild(b);
+      });
+    }
