APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ADMIN_EMAILS=grand.secretary@nglgreece.gr
COOKIE_SECURE=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=grand.secretary@nglgreece.gr
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
OTP_FROM_EMAIL=grand.secretary@nglgreece.gr
DEV_SHOW_OTP=1

PRIMARY_ADMIN_EMAIL=dskiad@gmail.com
PRIMARY_ADMIN_PASSWORD_HASH=SHA256_OF_PRIVATE_ADMIN_PASSWORD

# Google Drive: αντίγραφο κάθε τελικού PDF στον φάκελο της Μεγάλης Γραμματείας.
# OAuth Client τύπου «Web application» (Google Cloud Console), με ενεργό το Google Drive API
# και Authorized redirect URI: https://nglg-letter-manager.onrender.com/drive/callback
# Μετά: Εφαρμογή > Google Drive > «Σύνδεση με Google Drive».
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Προαιρετικό: η δημόσια διεύθυνση της εφαρμογής (για το redirect URI)
PUBLIC_BASE_URL=https://nglg-letter-manager.onrender.com
